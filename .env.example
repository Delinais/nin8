# Optional overrides for `docker compose` (copy to .env, or run docker/setup.sh
# which generates it). Compose reads .env automatically; everything has a default.

# Host user the container runs as. Must match `id -u` / `id -g` (default: 1000,
# which is the first user on Garuda/Arch).
NIN8_UID=1000
NIN8_GID=1000

# Cap parallel compile jobs if the image build runs out of memory (0 = all cores).
# NIN8_BUILD_JOBS=4

# Hardware MIDI input (needs /dev/snd/seq on the host; see compose.midi.yaml).
# AUDIO_GID=995
# COMPOSE_FILE=compose.yaml:compose.midi.yaml
